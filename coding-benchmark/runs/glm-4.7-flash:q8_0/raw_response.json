sk_id,))\n    if not cursor.fetchone():\n        conn.close()\n        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Task not found\")\n        \n    cursor.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\n    conn.commit()\n    conn.close()\n    \n    return None\n```", "done": true, "done_reason": "stop", "context": [154822, 154824, 154827, 2610, 525, 2661, 264, 25051, 369, 264, 2613, 25336, 5333, 13, 30949, 432, 6896, 438, 5189, 382, 5097, 26601, 279, 2480, 8793, 315, 264, 3175, 1034, 6941, 1887, 7197, 11, 4766, 825, 53913, 12663, 2038, 2504, 13, 2308, 16134, 1573, 476, 1283, 279, 2038, 2504, 13, 3155, 537, 6718, 3941, 5248, 3542, 382, 56101, 1447, 2, 5430, 39958, 5333, 1959, 10951, 271, 11061, 264, 25336, 5333, 369, 14838, 9076, 11, 1667, 3070, 32030, 7082, 334, 488, 3070, 81105, 334, 382, 565, 26582, 16963, 320, 21967, 11, 773, 2550, 374, 1273, 480, 3941, 4119, 692, 12, 46851, 1082, 781, 1034, 25, 1565, 3817, 7197, 7808, 518, 279, 2390, 3704, 624, 12, 576, 17267, 7082, 906, 2867, 1969, 387, 1159, 480, 438, 1565, 3817, 1601, 18606, 12, 14683, 25, 28235, 11, 304, 264, 1034, 6941, 1565, 24684, 7076, 63, 304, 279, 3238, 6220, 13, 4230, 279, 5952, 45058, 9459, 389, 20524, 421, 432, 3171, 944, 3000, 320, 2152, 11371, 11900, 3019, 4292, 12, 57228, 19506, 25, 1565, 9346, 2068, 7808, 1565, 12052, 50030, 7808, 1565, 3288, 67, 8158, 7808, 323, 2987, 279, 1460, 2740, 1565, 36848, 18, 63, 476, 1565, 3544, 34731, 28487, 2308, 1008, 12620, 92864, 320, 68, 1302, 13, 902, 28076, 14941, 5846, 4292, 12, 2308, 16636, 11, 902, 7299, 8693, 10515, 1959, 3175, 6094, 3383, 1140, 382, 565, 2885, 1614, 25, 5430, 271, 91, 8600, 760, 3990, 760, 18040, 9245, 91, 4421, 91, 4421, 91, 4421, 7360, 91, 877, 760, 526, 760, 3233, 3419, 13468, 11, 12601, 553, 279, 3538, 9245, 91, 2265, 760, 607, 760, 2567, 11, 220, 16, 4142, 98867, 22939, 320, 6280, 39218, 1283, 11008, 8, 9245, 91, 4008, 760, 607, 96340, 845, 760, 10096, 11, 902, 3084, 3930, 9245, 91, 8144, 760, 1807, 