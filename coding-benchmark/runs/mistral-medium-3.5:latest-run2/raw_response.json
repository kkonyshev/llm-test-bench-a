{"model": "mistral-medium-3.5:latest", "created_at": "2026-10-21T23:52:35.336083297Z", "response": "```python\nfrom datetime import datetime\nfrom typing import Optional, List\n\nfrom fastapi import FastAPI, HTTPException, Query, status\nfrom pydantic import BaseModel, Field, validator\nfrom sqlite3 import connect, Row\n\napp = FastAPI(title=\"Task Tracker API\")\n\nPRIORITIES = {\"low\", \"medium\", \"high\"}\n\nclass TaskCreate(BaseModel):\n    title: str = Field(..., min_length=1, max_length=200)\n    description: Optional[str] = None\n    priority: Optional[str] = \"medium\"\n\n    @validator(\"priority\")\n    def priority_must_be_valid(cls, v):\n        if v and v.lower() not in PRIORITIES:\n            raise ValueError(f\"priority must be one of {PRIORITIES}\")\n        return v.lower() if v else \"medium\"\n\nclass TaskUpdate(BaseModel):\n    title: Optional[str] = Field(None, min_length=1, max_length=200)\n    description: Optional[str] = None\n    completed: Optional[bool] = None\n    priority: Optional[str] = None\n\n    @validator(\"priority\")\n    def priority_must_be_valid(cls, v):\n        if v and v.lower() not in PRIORITIES:\n            raise ValueError(f\"priority must be one of {PRIORITIES}\")\n        return v.lower() if v else None\n\nclass TaskOut(BaseModel):\n    id: int\n    title: str\n    description: Optional[str]\n    completed: bool\n    priority: str\n    created_at: str\n\ndef get_db():\n    conn = connect(\"tasks.db\", check_same_thread=False)\n    conn.row_factory = Row\n    conn.execute(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS tasks (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL,\n            description TEXT,\n            completed BOOLEAN NOT NULL DEFAULT 0,\n            priority TEXT NOT NULL DEFAULT 'medium',\n            created_at TEXT NOT NULL\n        )\n        \"\"\"\n    )\n    return conn\n\n@app.on_event(\"startup\")\ndef on_startup():\n    get_db()\n\ndef row_to_task(row: Row) -> TaskOut:\n    return TaskOut(\n        id=row[\"id\"],\n        title=row[\"title\"],\n        description=row[\"description\"],\n        completed=bool(row[\"completed\"]),\n        priority=row[\"priority\"],\n        created_at=row[\"created_at\"],\n    )\n\n@app.post(\"/tasks\", response_model=TaskOut, status_code=status.HTTP_201_CREATED)\ndef create_task(task: TaskCreate):\n    db = get_db()\n    now = datetime.utcnow().isoformat()\n    cursor = db.execute(\n        \"\"\"\n        INSERT INTO tasks (title, description, completed, priority, created_at)\n        VALUES (?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            task.title.strip(),\n            task.description,\n            False,\n            task.priority,\n            now,\n        ),\n    )\n    db.commit()\n    task_id = cursor.lastrowid\n    row = db.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    db.close()\n    return row_to_task(row)\n\n@app.get(\"/tasks\", response_model=dict)\ndef list_tasks(\n    completed: Optional[bool] = None,\n    priority: Optional[str] = None,\n    page: int = Query(1, ge=1),\n    page_size: int = Query(10, ge=1, le=100),\n):\n    if priority and priority.lower() not in PRIORITIES:\n        raise HTTPException(status_code=422, detail=\"priority must be one of low, medium, high\")\n\n    db = get_db()\n    query = \"SELECT COUNT(*) FROM tasks WHERE 1=1\"\n    params: List = []\n    if completed is not None:\n        query += \" AND completed = ?\"\n        params.append(int(completed))\n    if priority:\n        query += \" AND priority = ?\"\n        params.append(priority.lower())\n    total = db.execute(query, tuple(params)).fetchone()[0]\n\n    query = \"SELECT * FROM tasks WHERE 1=1\"\n    if completed is not None:\n        query += \" AND completed = ?\"\n        params.append(int(completed))\n    if priority:\n        query += \" AND priority = ?\"\n        params.append(priority.lower())\n    query += \" ORDER BY id ASC LIMIT ? OFFSET ?\"\n    params.extend([page_size, (page - 1) * page_size])\n    rows = db.execute(query, tuple(params)).fetchall()\n    db.close()\n\n    return {\n        \"items\": [row_to_task(row) for row in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n\n@app.get(\"/tasks/{task_id}\", response_model=TaskOut)\ndef get_task(task_id: int):\n    db = get_db()\n    row = db.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    db.close()\n    if row is None:\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n    return row_to_task(row)\n\n@app.put(\"/tasks/{task_id}\", response_model=TaskOut)\ndef update_task(task_id: int, task: TaskUpdate):\n    db = get_db()\n    row = db.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    if row is None:\n        db.close()\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n\n    updates = []\n    params: List = []\n    if task.title is not None:\n        updates.append(\"title = ?\")\n        params.append(task.title.strip())\n    if task.description is not None:\n        updates.append(\"description = ?\")\n        params.append(task.description)\n    if task.completed is not None:\n        updates.append(\"completed = ?\")\n        params.append(int(task.completed))\n    if task.priority is not None:\n        updates.append(\"priority = ?\")\n        params.append(task.priority)\n\n    if not updates:\n        db.close()\n        return row_to_task(row)\n\n    params.append(task_id)\n    query = f\"UPDATE tasks SET {', '.join(updates)} WHERE id = ?\"\n    db.execute(query, tuple(params))\n    db.commit()\n\n    row = db.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    db.close()\n    return row_to_task(row)\n\n@app.delete(\"/tasks/{task_id}\", status_code=status.HTTP_204_NO_CONTENT)\ndef delete_task(task_id: int):\n    db = get_db()\n    cursor = db.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\n    db.commit()\n    if cursor.rowcount == 0:\n        db.close()\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n    db.close()\n```", "done": true, "done_reason": "stop", "context": [1, 17, 4568, 1584, 42301, 2784, 5624, 53721, 1045, 1052, 1045, 1049, 1049, 1057, 1066, 1045, 1050, 1054, 1048, 1051, 1044, 1261, 43520, 26242, 11512, 1319, 23947, 1077, 1041, 6254, 1536, 42301, 2784, 26554, 1044, 1261, 8689, 53862, 3518, 125609, 1294, 6993, 1626, 4568, 4053, 1420, 26554, 27089, 4418, 2301, 38680, 1626, 16994, 7807, 4469, 1486, 3804, 12220, 1408, 27533, 1044, 6032, 1032, 1049, 1044, 1032, 1050, 1048, 1050, 1052, 1626, 1784, 3519, 5451, 1395, 1445, 82934, 51919, 7651, 1636, 6185, 1605, 5257, 2314, 2269, 3686, 1505, 2200, 1278, 3330, 1681, 4546, 10867, 2015, 6793, 43546, 1505, 4811, 2181, 1044, 1636, 4016, 2210, 1278, 5178, 12589, 1317, 15273, 1278, 3686, 1046, 5469, 1605, 89786, 1317, 2210, 12589, 26119, 2127, 1710, 5234, 1261, 2081, 18501, 1505, 7662, 4005, 1046, 3367, 1836, 11157, 12589, 1584, 5178, 1044, 2430, 11904, 3468, 1455, 1636, 2607, 2405, 1736, 1278, 3686, 1321, 10035, 6187, 2015, 7211, 1626, 5475, 1278, 3330, 1681, 4098, 1395, 1605, 6133, 1044, 61103, 1044, 1505, 3120, 1605, 5234, 6171, 5315, 1394, 1636, 1317, 32181, 4832, 1278, 4098, 1044, 1636, 1653, 1605, 3352, 1317, 4832, 1494, 3169, 5109, 1321, 1636, 6153, 4237, 1278, 3330, 1317, 38695, 2034, 4546, 1319, 1101, 3596, 1046, 1429, 7493, 1584, 2269, 3683, 40378, 3879, 1639, 10555, 2297, 1429, 17507, 1584, 1636, 10555, 1505, 1429, 7651, 1395, 1278, 4275, 18034, 1317, 23286, 1034, 2297, 1429, 17507, 1653, 1636, 10601, 1562, 10555, 4342, 4568, 1584, 5282, 3435, 41132, 1556, 1317, 18814, 1044, 1294, 4369, 1636, 3352, 1317, 18507, 18814, 1319, 1101, 3596, 1046, 1429, 1121, 32430, 1034, 1395, 1445, 1121, 32430, 4672, 1321, 2200, 6136, 2314, 3686, 1513, 4811, 18814, 1044, 1636, 89782, 3686, 1455, 1395, 1513, 3866, 5451, 1626, 4568, 2685, 25