{"model": "llama3.1:70b", "created_at": "2026-09-17T16:13:39.585473677Z", "response": "```python\nimport os\nimport sqlite3\nfrom fastapi import FastAPI, HTTPException, Request, Response\nfrom fastapi.responses import JSONResponse\nfrom fastapi.encoders import jsonable_encoder\nfrom pydantic import BaseModel, validator, ValidationError, root_validator\nfrom typing import Optional, List\nfrom datetime import datetime\n\napp = FastAPI()\n\n# Create a connection to the SQLite database\nconn = sqlite3.connect('tasks.db')\ncursor = conn.cursor()\n\n# Create the tasks table if it doesn't exist\ncursor.execute('''\n    CREATE TABLE IF NOT EXISTS tasks (\n        id INTEGER PRIMARY KEY AUTOINCREMENT,\n        title TEXT NOT NULL,\n        description TEXT,\n        completed INTEGER NOT NULL DEFAULT 0,\n        priority TEXT NOT NULL DEFAULT 'medium',\n        created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n    )\n''')\nconn.commit()\n\n# Data model: Task\nclass Task(BaseModel):\n    id: int\n    title: str\n    description: Optional[str]\n    completed: bool\n    priority: str\n    created_at: str\n\n    class Config:\n        orm_mode = True\n\n    @root_validator(pre=True)\n    def check_title(cls, values):\n        if not values['title'].strip():\n            raise ValueError('Title is required and cannot be empty')\n        return values\n\n    @validator('priority')\n    def validate_priority(cls, v):\n        if v not in ['low', 'medium', 'high']:\n            raise ValueError('Invalid priority value')\n        return v\n\n# Endpoints\n@app.post('/tasks', response_model=Task, status_code=201)\ndef create_task(task: Task):\n    try:\n        cursor.execute('INSERT INTO tasks (title, description, completed, priority) VALUES (?, ?, ?, ?)',\n                       (task.title, task.description, task.completed, task.priority))\n        conn.commit()\n        task.id = cursor.lastrowid\n        task.created_at = datetime.now().isoformat()\n        return task\n    except ValidationError as e:\n        raise HTTPException(status_code=422, detail=e.errors())\n\n@app.get('/tasks', response_model=List[Task])\ndef list_tasks(completed: Optional[bool] = None, priority: Optional[str] = None, page: int = 1, page_size: int = 10):\n    try:\n        query = 'SELECT * FROM tasks'\n        params = []\n        if completed is not None:\n            query += ' WHERE completed = ?'\n            params.append(int(completed))\n        if priority:\n            if 'WHERE' not in query:\n                query += ' WHERE'\n            else:\n                query += ' AND'\n            query += ' priority = ?'\n            params.append(priority)\n        query += ' ORDER BY id ASC LIMIT ? OFFSET ?'\n        params.extend([page_size, (page - 1) * page_size])\n        cursor.execute(query, params)\n        tasks = [Task(**row) for row in cursor.fetchall()]\n        total = cursor.execute('SELECT COUNT(*) FROM tasks', params[:-2]).fetchone()[0]\n        return {'items': tasks, 'total': total, 'page': page, 'page_size': page_size}\n    except ValidationError as e:\n        raise HTTPException(status_code=422, detail=e.errors())\n\n@app.get('/tasks/{id}', response_model=Task)\ndef get_task(id: int):\n    cursor.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n    task = cursor.fetchone()\n    if not task:\n        raise HTTPException(status_code=404)\n    return Task(**task)\n\n@app.put('/tasks/{id}', response_model=Task)\ndef update_task(id: int, task: Task):\n    cursor.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n    existing_task = cursor.fetchone()\n    if not existing_task:\n        raise HTTPException(status_code=404)\n    try:\n        updated_task = Task(**{**existing_task, **task.dict(exclude_unset=True)})\n        cursor.execute('UPDATE tasks SET title = ?, description = ?, completed = ?, priority = ? WHERE id = ?',\n                       (updated_task.title, updated_task.description, updated_task.completed, updated_task.priority, id))\n        conn.commit()\n        return updated_task\n    except ValidationError as e:\n        raise HTTPException(status_code=422, detail=e.errors())\n\n@app.delete('/tasks/{id}')\ndef delete_task(id: int):\n    cursor.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n    task = cursor.fetchone()\n    if not task:\n        raise HTTPException(status_code=404)\n    cursor.execute('DELETE FROM tasks WHERE id = ?', (id,))\n    conn.commit()\n    return Response(status_code=204)\n```", "done": true, "done_reason": "stop", "context": [128006, 882, 128007, 271, 2675, 527, 2728, 264, 26185, 369, 264, 2678, 26487, 5446, 13, 32175, 433, 7041, 439, 5300, 382, 5207, 27785, 279, 2539, 8970, 315, 264, 3254, 1052, 7086, 1925, 7345, 11, 4871, 832, 55375, 12958, 2082, 2565, 13, 2360, 16540, 1603, 477, 1306, 279, 2082, 2565, 13, 3234, 539, 6859, 4028, 5361, 3626, 382, 57581, 1473, 2, 5546, 41279, 5446, 2001, 11197, 271, 11313, 264, 26487, 5446, 369, 15194, 9256, 11, 1701, 3146, 33274, 7227, 334, 489, 3146, 82872, 334, 382, 567, 27766, 17413, 320, 22795, 11, 779, 2612, 374, 1296, 481, 4028, 4211, 696, 12, 48241, 1100, 787, 1052, 25, 1595, 3902, 7345, 7964, 520, 279, 2447, 3789, 627, 12, 578, 17737, 7227, 917, 2937, 2011, 387, 1179, 481, 439, 1595, 3902, 1632, 19154, 12, 15035, 25, 29434, 11, 304, 264, 1052, 7086, 1595, 25792, 7221, 63, 304, 279, 3318, 6352, 13, 4324, 279, 6078, 46426, 9651, 389, 21210, 422, 433, 3250, 956, 3073, 320, 2201, 11630, 12172, 3094, 4390, 12, 58722, 20113, 25, 1595, 9533, 2113, 7964, 1595, 12328, 51456, 7964, 1595, 3368, 67, 8322, 7964, 323, 3060, 279, 1487, 2808, 1595, 38142, 18, 63, 477, 1595, 3628, 36005, 29687, 2360, 1023, 12914, 94750, 320, 68, 1326, 13, 912, 29273, 15302, 5970, 4390, 12, 2360, 17066, 11, 912, 7447, 8865, 10742, 2001, 3254, 6222, 3465, 1160, 382, 567, 2956, 1646, 25, 5546, 271, 91, 8771, 765, 4078, 765, 18559, 9432, 91, 4521, 91, 4521, 91, 4521, 7511, 91, 887, 765, 528, 765, 3313, 3502, 13785, 11, 12893, 555, 279, 3622, 9432, 