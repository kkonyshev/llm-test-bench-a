{"model": "mistral-small3.2:latest", "created_at": "2026-10-21T21:24:21.086087996Z", "response": "```python\nfrom fastapi import FastAPI, HTTPException, status\nfrom pydantic import BaseModel, Field, constr\nfrom typing import Optional, List\nfrom datetime import datetime\nimport sqlite3\nfrom sqlite3 import Connection\nfrom contextlib import contextmanager\n\napp = FastAPI()\n\nDATABASE_URL = \"tasks.db\"\nPRIORITY_OPTIONS = [\"low\", \"medium\", \"high\"]\n\nclass Task(BaseModel):\n    id: int\n    title: str = Field(..., min_length=1, max_length=200)\n    description: Optional[str] = None\n    completed: bool = False\n    priority: str = Field(\"medium\", constr(to_lower=True))\n    created_at: datetime = Field(default_factory=datetime.now)\n\nclass TaskCreate(BaseModel):\n    title: str = Field(..., min_length=1, max_length=200)\n    description: Optional[str] = None\n    priority: Optional[str] = Field(None, constr(to_lower=True))\n\nclass TaskUpdate(BaseModel):\n    title: Optional[str] = Field(None, min_length=1, max_length=200)\n    description: Optional[str] = None\n    completed: Optional[bool] = None\n    priority: Optional[str] = Field(None, constr(to_lower=True))\n\n@contextmanager\ndef get_db():\n    conn = sqlite3.connect(DATABASE_URL)\n    try:\n        yield conn\n    finally:\n        conn.close()\n\ndef init_db():\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"\"\"\n            CREATE TABLE IF NOT EXISTS tasks (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                title TEXT NOT NULL,\n                description TEXT,\n                completed BOOLEAN DEFAULT FALSE,\n                priority TEXT DEFAULT 'medium',\n                created_at TEXT NOT NULL\n            )\n        \"\"\")\n        conn.commit()\n\ninit_db()\n\n@app.post(\"/tasks\", status_code=status.HTTP_201_CREATED)\nasync def create_task(task: TaskCreate):\n    if task.priority and task.priority not in PRIORITY_OPTIONS:\n        raise HTTPException(\n            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n            detail=\"Priority must be one of: low, medium, high\"\n        )\n\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"\"\"\n            INSERT INTO tasks (title, description, priority, created_at)\n            VALUES (?, ?, ?, ?)\n        \"\"\", (\n            task.title.strip(),\n            task.description,\n            task.priority if task.priority else \"medium\",\n            datetime.now().isoformat()\n        ))\n        conn.commit()\n        task_id = cursor.lastrowid\n\n    return Task(\n        id=task_id,\n        title=task.title.strip(),\n        description=task.description,\n        completed=False,\n        priority=task.priority if task.priority else \"medium\",\n        created_at=datetime.now()\n    )\n\n@app.get(\"/tasks\", response_model=dict)\nasync def list_tasks(\n    completed: Optional[bool] = None,\n    priority: Optional[str] = None,\n    page: int = 1,\n    page_size: int = 10\n):\n    if page < 1:\n        raise HTTPException(\n            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n            detail=\"Page must be >= 1\"\n        )\n    if page_size < 1 or page_size > 100:\n        raise HTTPException(\n            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n            detail=\"Page size must be between 1 and 100\"\n        )\n    if priority and priority not in PRIORITY_OPTIONS:\n        raise HTTPException(\n            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n            detail=\"Priority must be one of: low, medium, high\"\n        )\n\n    with get_db() as conn:\n        cursor = conn.cursor()\n\n        query = \"SELECT COUNT(*) FROM tasks WHERE 1=1\"\n        params = []\n        if completed is not None:\n            query += \" AND completed = ?\"\n            params.append(completed)\n        if priority:\n            query += \" AND priority = ?\"\n            params.append(priority)\n\n        cursor.execute(query, params)\n        total = cursor.fetchone()[0]\n\n        query = \"\"\"\n            SELECT id, title, description, completed, priority, created_at\n            FROM tasks\n            WHERE 1=1\n        \"\"\"\n        params = []\n        if completed is not None:\n            query += \" AND completed = ?\"\n            params.append(completed)\n        if priority:\n            query += \" AND priority = ?\"\n            params.append(priority)\n        query += \" ORDER BY id ASC LIMIT ? OFFSET ?\"\n\n        cursor.execute(query, params + [page_size, (page - 1) * page_size])\n        tasks = cursor.fetchall()\n\n    items = [\n        Task(\n            id=row[0],\n            title=row[1],\n            description=row[2],\n            completed=row[3],\n            priority=row[4],\n            created_at=datetime.fromisoformat(row[5])\n        )\n        for row in tasks\n    ]\n\n    return {\n        \"items\": items,\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size\n    }\n\n@app.get(\"/tasks/{task_id}\", response_model=Task)\nasync def get_task(task_id: int):\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id, title, description, completed, priority, created_at FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n\n    if not row:\n        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Task not found\")\n\n    return Task(\n        id=row[0],\n        title=row[1],\n        description=row[2],\n        completed=row[3],\n        priority=row[4],\n        created_at=datetime.fromisoformat(row[5])\n    )\n\n@app.put(\"/tasks/{task_id}\", response_model=Task)\nasync def update_task(task_id: int, task: TaskUpdate):\n    if task.priority and task.priority not in PRIORITY_OPTIONS:\n        raise HTTPException(\n            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n            detail=\"Priority must be one of: low, medium, high\"\n        )\n\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id FROM tasks WHERE id = ?\", (task_id,))\n        if not cursor.fetchone():\n            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Task not found\")\n\n        update_fields = []\n        params = []\n\n        if task.title is not None:\n            update_fields.append(\"title = ?\")\n            params.append(task.title.strip())\n        if task.description is not None:\n            update_fields.append(\"description = ?\")\n            params.append(task.description)\n        if task.completed is not None:\n            update_fields.append(\"completed = ?\")\n            params.append(task.completed)\n        if task.priority is not None:\n            update_fields.append(\"priority = ?\")\n            params.append(task.priority)\n\n        if not update_fields:\n            raise HTTPException(\n                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n                detail=\"No fields to update\"\n            )\n\n        query = f\"UPDATE tasks SET {', '.join(update_fields)} WHERE id = ?\"\n        params.append(task_id)\n        cursor.execute(query, params)\n        conn.commit()\n\n        cursor.execute(\"SELECT id, title, description, completed, priority, created_at FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n\n    return Task(\n        id=row[0],\n        title=row[1],\n        description=row[2],\n        completed=row[3],\n        priority=row[4],\n        created_at=datetime.fromisoformat(row[5])\n    )\n\n@app.delete(\"/tasks/{task_id}\", status_code=status.HTTP_204_NO_CONTENT)\nasync def delete_task(task_id: int):\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id FROM tasks WHERE id = ?\", (task_id,))\n        if not cursor.fetchone():\n            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Task not found\")\n\n        cursor.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\n        conn.commit()\n```", "done": true, "done_reason": "stop", "context": [17, 4568, 1584, 42301, 2784, 29121, 1032, 1051, 1046, 1050, 1044, 1261, 43520, 26242, 11512, 1319, 23947, 1077, 1041, 6254, 1536, 42301, 2784, 26554, 1044, 1261, 8689, 53862, 3518, 125609, 1294, 6993, 1626, 4568, 4053, 1420, 26554, 27089, 4418, 2301, 38680, 1626, 16994, 7807, 4469, 1486, 3804, 12220, 1408, 1032, 1050, 1048, 1050, 1051, 1045, 1049, 1048, 1045, 1048, 1049, 1338, 7651, 1636, 6185, 1605, 5257, 2314, 2269, 3686, 1505, 2200, 1278, 3330, 1681, 4546, 10867, 2015, 6793, 43546, 1505, 4811, 2181, 1044, 1636, 4016, 2210, 1278, 5178, 12589, 1317, 15273, 1278, 3686, 1046, 5469, 1605, 89786, 1317, 2210, 12589, 26119, 2127, 1710, 5234, 1261, 2081, 18501, 1505, 7662, 4005, 1046, 3367, 1836, 11157, 12589, 1584, 5178, 1044, 2430, 11904, 3468, 1455, 1636, 2607, 2405, 1736, 1278, 3686, 1321, 10035, 6187, 2015, 7211, 1626, 5475, 1278, 3330, 1681, 4098, 1395, 1605, 6133, 1044, 61103, 1044, 1505, 3120, 1605, 5234, 6171, 5315, 1394, 1636, 1317, 32181, 4832, 1278, 4098, 1044, 1636, 1653, 1605, 3352, 1317, 4832, 1494, 3169, 5109, 1321, 1636, 6153, 4237, 1278, 3330, 1317, 38695, 2034, 4546, 1319, 1101, 3596, 1046, 1429, 7493, 1584, 2269, 3683, 40378, 3879, 1639, 10555, 2297, 1429, 17507, 1584, 1636, 10555, 1505, 1429, 7651, 1395, 1278, 4275, 18034, 1317, 23286, 1034, 2297, 1429, 17507, 1653, 1636, 10601, 1562, 10555, 4342, 4568, 1584, 5282, 3435, 41132, 1556, 1317, 18814, 1044, 1294, 4369, 1636, 3352, 1317, 18507, 18814, 1321, 2200, 6136, 2314, 3686, 1513, 4811, 18814, 1044, 1636, 89782, 3686, 1455, 1395, 1513, 3866, 5451, 1626, 4568, 2685, 2576, 15776, 1294, 1747, 18085, 1044, 1321, 5282, 9148, 1317, 1278, 3330, 1294, 1278, 7278, 2127, 2210, 1505, 4546, 1626, 12961, 14275, 12293, 1278, 28946, 1455, 1636, 1736, 1338, 1035, 1488, 34112, 1398, 4755, 20266, 9774, 7236, 3