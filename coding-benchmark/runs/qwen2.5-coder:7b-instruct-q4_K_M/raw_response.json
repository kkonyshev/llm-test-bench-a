{"model": "qwen2.5-coder:7b-instruct-q4_K_M", "created_at": "2026-09-17T16:08:50.446715302Z", "response": "```python\nfrom fastapi import FastAPI, HTTPException, Depends, Query\nfrom pydantic import BaseModel, validator\nfrom typing import List, Optional, Dict\nfrom datetime import datetime\nimport sqlite3\n\napp = FastAPI()\n\nclass Task(BaseModel):\n    id: Optional[int]\n    title: str\n    description: Optional[str] = None\n    completed: bool = False\n    priority: str = 'medium'\n    created_at: Optional[str] = None\n\n    @validator('title')\n    def title_must_not_be_empty(cls, v):\n        if not v.strip():\n            raise ValueError('Title cannot be empty')\n        return v\n\n    @validator('priority')\n    def priority_must_be_valid(cls, v):\n        if v not in ['low', 'medium', 'high']:\n            raise ValueError('Priority must be one of low, medium, high')\n        return v\n\n    @validator('created_at', pre=True, always=True)\n    def set_created_at(cls, v):\n        if not v:\n            return datetime.utcnow().isoformat()\n        return v\n\ndef get_db_connection():\n    conn = sqlite3.connect('tasks.db')\n    conn.row_factory = sqlite3.Row\n    return conn\n\n@app.on_event('startup')\ndef create_tables():\n    conn = get_db_connection()\n    conn.execute('''\n        CREATE TABLE IF NOT EXISTS tasks (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL,\n            description TEXT,\n            completed BOOLEAN DEFAULT FALSE,\n            priority TEXT DEFAULT 'medium',\n            created_at TEXT NOT NULL\n        )\n    ''')\n    conn.commit()\n    conn.close()\n\n@app.post('/tasks', response_model=Task, status_code=201)\ndef create_task(task: Task, db=Depends(get_db_connection)):\n    task.created_at = datetime.utcnow().isoformat()\n    cursor = db.cursor()\n    cursor.execute('''\n        INSERT INTO tasks (title, description, completed, priority, created_at)\n        VALUES (?, ?, ?, ?, ?)\n    ''', (task.title, task.description, task.completed, task.priority, task.created_at))\n    db.commit()\n    task.id = cursor.lastrowid\n    return task\n\n@app.get('/tasks', response_model=Dict)\ndef list_tasks(\n    completed: Optional[bool] = None,\n    priority: Optional[str] = Query(None, regex='^(low|medium|high)$'),\n    page: int = Query(1, ge=1),\n    page_size: int = Query(10, ge=1, le=100),\n    db=Depends(get_db_connection)\n):\n    cursor = db.cursor()\n    query = 'SELECT * FROM tasks'\n    params = []\n    if completed is not None:\n        query += ' WHERE completed = ?'\n        params.append(completed)\n    if priority is not None:\n        if query.endswith('WHERE'):\n            query += ' AND priority = ?'\n        else:\n            query += ' WHERE priority = ?'\n        params.append(priority)\n    query += ' ORDER BY id ASC LIMIT ? OFFSET ?'\n    params.extend([page_size, (page - 1) * page_size])\n    cursor.execute(query, params)\n    items = [dict(row) for row in cursor.fetchall()]\n    total = cursor.execute('SELECT COUNT(*) FROM tasks WHERE 1=1' + (' AND completed = ?' if completed is not None else '') + (' AND priority = ?' if priority is not None else ''), params).fetchone()[0]\n    return {\n        'items': items,\n        'total': total,\n        'page': page,\n        'page_size': page_size\n    }\n\n@app.get('/tasks/{id}', response_model=Task, responses={404: {'detail': 'Task not found'}})\ndef get_task(id: int, db=Depends(get_db_connection)):\n    cursor = db.cursor()\n    cursor.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n    row = cursor.fetchone()\n    if row:\n        return dict(row)\n    else:\n        raise HTTPException(status_code=404, detail='Task not found')\n\n@app.put('/tasks/{id}', response_model=Task, responses={404: {'detail': 'Task not found'}, 422: {'detail': 'Validation error'}})\ndef update_task(id: int, task: Task, db=Depends(get_db_connection)):\n    cursor = db.cursor()\n    cursor.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n    row = cursor.fetchone()\n    if row:\n        updates = {k: v for k, v in task.dict().items() if v is not None}\n        if 'title' in updates:\n            validator('title')(updates['title'])\n        if 'priority' in updates:\n            validator('priority')(updates['priority'])\n        set_clause = ', '.join([f'{k} = ?' for k in updates.keys()])\n        update_params = tuple(updates.values()) + (id,)\n        cursor.execute(f'UPDATE tasks SET {set_clause} WHERE id = ?', update_params)\n        db.commit()\n        cursor.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n        updated_task = dict(cursor.fetchone())\n        return updated_task\n    else:\n        raise HTTPException(status_code=404, detail='Task not found')\n\n@app.delete('/tasks/{id}', status_code=204, responses={404: {'detail': 'Task not found'}})\ndef delete_task(id: int, db=Depends(get_db_connection)):\n    cursor = db.cursor()\n    cursor.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n    row = cursor.fetchone()\n    if row:\n        cursor.execute('DELETE FROM tasks WHERE id = ?', (id,))\n        db.commit()\n    else:\n        raise HTTPException(status_code=404, detail='Task not found')\n```", "done": true, "done_reason": "stop", "context": [151644, 8948, 198, 2610, 525, 1207, 16948, 11, 3465, 553, 54364, 14817, 13, 1446, 525, 264, 10950, 17847, 13, 151645, 198, 151644, 872, 198, 2610, 525, 2661, 264, 25128, 369, 264, 2613, 25414, 5333, 13, 31075, 432, 6896, 438, 5189, 382, 5097, 26687, 279, 2480, 8794, 315, 264, 3175, 1034, 6941, 1887, 7197, 11, 4766, 825, 54275, 12669, 2038, 2504, 13, 2308, 16148, 1573, 476, 1283, 279, 2038, 2504, 13, 3155, 537, 6718, 3941, 5248, 3542, 382, 56481, 1447, 2, 5430, 40179, 5333, 1959, 10956, 271, 11066, 264, 25414, 5333, 369, 14849, 9079, 11, 1667, 3070, 32174, 7082, 334, 488, 3070, 81772, 334, 382, 565, 26668, 16982, 320, 22021, 11, 773, 2550, 374, 1273, 480, 3941, 4119, 692, 12, 47141, 1082, 781, 1034, 25, 