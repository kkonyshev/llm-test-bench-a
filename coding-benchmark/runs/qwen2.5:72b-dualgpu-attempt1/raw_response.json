{"model": "qwen2.5:72b", "created_at": "2026-09-17T16:30:09.095297893Z", "response": "```python\nfrom fastapi import FastAPI, HTTPException, Query, Path, Body, Depends\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel, constr, Field\nfrom typing import Optional, List\nimport sqlite3\nfrom datetime import datetime\n\napp = FastAPI()\n\n# Database initialization\ndef get_db():\n    conn = sqlite3.connect('tasks.db')\n    conn.row_factory = sqlite3.Row\n    create_table(conn)\n    return conn\n\ndef create_table(conn):\n    conn.execute('''\n        CREATE TABLE IF NOT EXISTS tasks (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL,\n            description TEXT,\n            completed BOOLEAN DEFAULT FALSE,\n            priority TEXT DEFAULT 'medium',\n            created_at TEXT NOT NULL\n        )\n    ''')\n    conn.commit()\n\n# Pydantic Models\nclass TaskCreate(BaseModel):\n    title: constr(min_length=1, max_length=200, strip_whitespace=True)\n    description: Optional[str]\n    priority: Optional[constr(regex=\"^(low|medium|high)$\")] = 'medium'\n\nclass TaskUpdate(BaseModel):\n    title: Optional[constr(min_length=1, max_length=200, strip_whitespace=True)]\n    description: Optional[str]\n    completed: Optional[bool]\n    priority: Optional[constr(regex=\"^(low|medium|high)$\")]\n\nclass Task(TaskCreate):\n    id: int\n    completed: bool = False\n    created_at: str\n\n# Dependency to get a database connection\ndef get_conn():\n    conn = get_db()\n    try:\n        yield conn\n    finally:\n        conn.close()\n\n# Endpoints\n@app.post(\"/tasks\", response_model=Task, status_code=201)\ndef create_task(task: TaskCreate, conn: sqlite3.Connection = Depends(get_conn)):\n    now = datetime.utcnow().isoformat()\n    cursor = conn.cursor()\n    cursor.execute('''\n        INSERT INTO tasks (title, description, completed, priority, created_at)\n        VALUES (?, ?, ?, ?, ?)\n    ''', (task.title, task.description, task.completed, task.priority, now))\n    conn.commit()\n    task_id = cursor.lastrowid\n    return Task(id=task_id, **task.dict(), created_at=now)\n\n@app.get(\"/tasks\", response_model=List[Task])\ndef list_tasks(\n    completed: Optional[bool] = None,\n    priority: Optional[str] = None,\n    page: int = Query(1, ge=1),\n    page_size: int = Query(10, ge=1, le=100),\n    conn: sqlite3.Connection = Depends(get_conn)\n):\n    query = \"SELECT * FROM tasks WHERE 1=1\"\n    params = []\n    if completed is not None:\n        query += \" AND completed = ?\"\n        params.append(completed)\n    if priority is not None:\n        query += \" AND priority = ?\"\n        params.append(priority)\n    \n    cursor = conn.cursor()\n    cursor.execute(query + \" ORDER BY id ASC LIMIT ? OFFSET ?\", params + [page_size, (page - 1) * page_size])\n    tasks = [Task(**row) for row in cursor.fetchall()]\n    \n    cursor.execute(\"SELECT COUNT(*) FROM tasks WHERE 1=1\" + query[len(\"SELECT * FROM tasks WHERE 1=1\"):], params)\n    total = cursor.fetchone()[0]\n    \n    return JSONResponse(content={\"items\": tasks, \"total\": total, \"page\": page, \"page_size\": page_size})\n\n@app.get(\"/tasks/{id}\", response_model=Task)\ndef get_task(id: int, conn: sqlite3.Connection = Depends(get_conn)):\n    cursor = conn.cursor()\n    cursor.execute(\"SELECT * FROM tasks WHERE id = ?\", (id,))\n    task = cursor.fetchone()\n    if task:\n        return Task(**task)\n    raise HTTPException(status_code=404, detail=\"Task not found\")\n\n@app.put(\"/tasks/{id}\", response_model=Task)\ndef update_task(id: int, task_update: TaskUpdate, conn: sqlite3.Connection = Depends(get_conn)):\n    cursor = conn.cursor()\n    cursor.execute(\"SELECT * FROM tasks WHERE id = ?\", (id,))\n    existing_task = cursor.fetchone()\n    if not existing_task:\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n    \n    update_data = task_update.dict(exclude_unset=True)\n    if update_data:\n        set_clause = \", \".join([f\"{field} = ?\" for field in update_data.keys()])\n        params = list(update_data.values()) + [id]\n        cursor.execute(f\"UPDATE tasks SET {set_clause} WHERE id = ?\", params)\n        conn.commit()\n    \n    cursor.execute(\"SELECT * FROM tasks WHERE id = ?\", (id,))\n    updated_task = cursor.fetchone()\n    return Task(**updated_task)\n\n@app.delete(\"/tasks/{id}\", status_code=204)\ndef delete_task(id: int, conn: sqlite3.Connection = Depends(get_conn)):\n    cursor = conn.cursor()\n    cursor.execute(\"DELETE FROM tasks WHERE id = ?\", (id,))\n    if cursor.rowcount == 0:\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n    conn.commit()\n```", "done": true, "done_reason": "stop", "context": [151644, 8948, 198, 2610, 525, 1207, 16948, 11, 3465, 553, 54364, 14817, 13, 1446, 525, 264, 10950, 17847, 13, 151645, 198, 151644, 872, 198, 2610, 525, 2661, 264, 25128, 369, 264, 2613, 25414, 5333, 13, 31075, 432, 6896, 438, 5189, 382, 5097, 26687, 279, 2480, 8794, 315, 264, 3175, 1034, 6941, 1887, 7197, 11, 4766, 825, 54275, 12669, 2038, 2504, 13, 2308, 16148, 1573, 476, 1283, 279, 2038, 2504, 13, 3155, 537, 6718, 3941, 5248, 3542, 382, 56481, 1447, 2, 5430, 40179, 5333, 1959, 10956, 271, 11066, 264, 25414, 5333, 369, 14849, 9079, 11, 1667, 3070, 32174, 7082, 334, 488, 3070, 81772, 334, 382, 565, 26668, 16982, 320, 22021, 11, 773, 2550, 374, 1273, 480, 3941, 4119, 692, 12, 47141, 1082, 781, 1034, 25, 1565, 3817, 7197, 7808, 518, 279, 2390, 3704, 624, 12, 576, 17288, 7082, 906, 2867, 1969, 387, 1159, 480, 438, 1565, 3817, 1601, 18639, 12, 14693, 25, 28334, 11, 304, 264, 1034, 6941, 1565, 24760, 7076, 63, 304, 279, 3238, 6220, 13, 4230, 279, 5952, 45326, 9463, 389, 20567, 421, 432, 3171, 944, 3000, 320, 2152, 11376, 11906, 3019, 4292, 12, 57622, 19543, 25, 1565, 9349, 2068, 7808, 1565, 12058, 50356, 7808, 1565, 3288, 67, 8159, 7808, 323, 2987, 279, 1460, 2740, 1565, 37042, 18, 63, 476, 1565, 3544