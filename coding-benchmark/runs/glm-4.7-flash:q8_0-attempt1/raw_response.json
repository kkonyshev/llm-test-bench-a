{"model": "glm-4.7-flash:q8_0", "created_at": "2026-10-21T20:01:46.959766083Z", "response": "```python\nfrom typing import List, Optional\nfrom fastapi import FastAPI, Depends, HTTPException, Query\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel, Field\nimport sqlite3\nfrom contextlib import contextmanager\nfrom datetime import datetime\nimport uvicorn\n\napp = FastAPI()\n\n# -----------------------------------------------------------------------------\n# Configuration\n# -----------------------------------------------------------------------------\nDB_FILE = \"tasks.db\"\nVALID_PRIORITIES = [\"low\", \"medium\", \"high\"]\n\n# -----------------------------------------------------------------------------\n# Pydantic Models\n# -----------------------------------------------------------------------------\n\nclass TaskCreate(BaseModel):\n    title: str\n    description: Optional[str] = None\n    priority: Optional[str] = Field(default=\"medium\", regex=\"^(low|medium|high)$\")\n\nclass TaskUpdate(BaseModel):\n    title: Optional[str] = Field(default=None, min_length=1, max_length=200)\n    description: Optional[str] = None\n    completed: Optional[bool] = None\n    priority: Optional[str] = Field(default=None, regex=\"^(low|medium|high)$\")\n\nclass TaskResponse(BaseModel):\n    id: int\n    title: str\n    description: Optional[str] = None\n    completed: bool\n    priority: str\n    created_at: str\n\nclass TaskListResponse(BaseModel):\n    items: List[TaskResponse]\n    total: int\n    page: int\n    page_size: int\n\n# -----------------------------------------------------------------------------\n# Database Helper\n# -----------------------------------------------------------------------------\n\n@contextmanager\ndef get_db():\n    \"\"\"Context manager to handle SQLite connections.\"\"\"\n    conn = sqlite3.connect(DB_FILE)\n    conn.row_factory = sqlite3.Row\n    try:\n        yield conn\n    finally:\n        conn.close()\n\ndef init_db():\n    \"\"\"Initialize the database schema on startup.\"\"\"\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"\"\"\n        CREATE TABLE IF NOT EXISTS tasks (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL CHECK(length(trim(title)) > 0),\n            description TEXT,\n            completed INTEGER DEFAULT 0,\n            priority TEXT NOT NULL DEFAULT 'medium' CHECK(priority IN ('low', 'medium', 'high')),\n            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n        )\n        \"\"\")\n        conn.commit()\n\n# -----------------------------------------------------------------------------\n# Startup Event\n# -----------------------------------------------------------------------------\n\n@app.on_event(\"startup\")\ndef startup_event():\n    init_db()\n\n# -----------------------------------------------------------------------------\n# Utility: Convert Row to Model\n# -----------------------------------------------------------------------------\n\ndef _row_to_task(row: sqlite3.Row) -> TaskResponse:\n    return TaskResponse(\n        id=row[\"id\"],\n        title=row[\"title\"],\n        description=row[\"description\"],\n        completed=bool(row[\"completed\"]),\n        priority=row[\"priority\"],\n        created_at=row[\"created_at\"]\n    )\n\n# -----------------------------------------------------------------------------\n# Endpoints\n# -----------------------------------------------------------------------------\n\n# POST /tasks\n@app.post(\"/tasks\", response_model=TaskResponse, status_code=201)\ndef create_task(task: TaskCreate):\n    \"\"\"Create a new task.\"\"\"\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\n            \"INSERT INTO tasks (title, description, priority) VALUES (?, ?, ?)\",\n            (task.title, task.description, task.priority)\n        )\n        conn.commit()\n        task_id = cursor.lastrowid\n\n        cursor.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,))\n        new_row = cursor.fetchone()\n\n        if not new_row:\n            raise HTTPException(status_code=500, detail=\"Failed to retrieve created task\")\n        \n        return _row_to_task(new_row)\n\n# GET /tasks\n@app.get(\"/tasks\", response_model=TaskListResponse)\ndef list_tasks(\n    completed: Optional[bool] = Query(None),\n    priority: Optional[str] = Query(None),\n    page: int = Query(1, ge=1),\n    page_size: int = Query(10, ge=1, le=100)\n):\n    \"\"\"List tasks with optional filtering and pagination.\"\"\"\n    # Validate priority if provided\n    if priority is not None and priority not in VALID_PRIORITIES:\n        raise HTTPException(status_code=422, detail=\"Invalid priority value\")\n\n    with get_db() as conn:\n        cursor = conn.cursor()\n        \n        conditions = []\n        params = []\n\n        if completed is not None:\n            conditions.append(\"completed = ?\")\n            params.append(1 if completed else 0)\n\n        if priority is not None:\n            conditions.append(\"priority = ?\")\n            params.append(priority)\n\n        where_clause = \" AND \".join(conditions) if conditions else \"1=1\"\n        \n        # Get total count\n        count_sql = f\"SELECT COUNT(*) as total FROM tasks WHERE {where_clause}\"\n        cursor.execute(count_sql, params)\n        total = cursor.fetchone()[\"total\"]\n\n        # Get paginated items\n        offset = (page - 1) * page_size\n        items_sql = f\"SELECT * FROM tasks WHERE {where_clause} ORDER BY id ASC LIMIT ? OFFSET ?\"\n        params.extend([page_size, offset])\n        cursor.execute(items_sql, params)\n        rows = cursor.fetchall()\n\n        items = [_row_to_task(r) for r in rows]\n\n        return TaskListResponse(\n            items=items,\n            total=total,\n            page=page,\n            page_size=page_size\n        )\n\n# GET /tasks/{id}\n@app.get(\"/tasks/{id}\", response_model=TaskResponse)\ndef get_task(id: int):\n    \"\"\"Get a specific task by ID.\"\"\"\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT * FROM tasks WHERE id = ?\", (id,))\n        row = cursor.fetchone()\n\n        if not row:\n            raise HTTPException(status_code=404, detail=\"Task not found\")\n\n        return _row_to_task(row)\n\n# PUT /tasks/{id}\n@app.put(\"/tasks/{id}\", response_model=TaskResponse)\ndef update_task(id: int, task_update: TaskUpdate):\n    \"\"\"Update a specific task by ID.\"\"\"\n    with get_db() as conn:\n        cursor = conn.cursor()\n        \n        # Check existence\n        cursor.execute(\"SELECT id FROM tasks WHERE id = ?\", (id,))\n        if not cursor.fetchone():\n            raise HTTPException(status_code=404, detail=\"Task not found\")\n\n        # Prepare update data\n        update_data = task_update.dict(exclude_unset=True)\n        if not update_data:\n            # If no fields were provided, return current task\n            return get_task(id)\n\n        # Validate priority if provided in update\n        if \"priority\" in update_data and update_data[\"priority\"] not in VALID_PRIORITIES:\n            raise HTTPException(status_code=422, detail=\"Invalid priority value\")\n\n        # Validate title if provided (non-empty)\n        if \"title\" in update_data and not update_data[\"title\"].strip():\n            raise HTTPException(status_code=422, detail=\"Title cannot be empty\")\n\n        # Build SQL\n        set_clauses = []\n        values = []\n        for field, value in update_data.items():\n            set_clauses.append(f\"{field} = ?\")\n            values.append(value)\n\n        values.append(id) # Add ID for WHERE clause\n        sql = f\"UPDATE tasks SET {', '.join(set_clauses)} WHERE id = ?\"\n        \n        cursor.execute(sql, values)\n        conn.commit()\n\n        return get_task(id)\n\n# DELETE /tasks/{id}\n@app.delete(\"/tasks/{id}\")\ndef delete_task(id: int):\n    \"\"\"Delete a specific task by ID.\"\"\"\n    with get_db() as conn:\n        cursor = conn.cursor()\n        cursor.execute(\"DELETE FROM tasks WHERE id = ?\", (id,))\n        \n        if cursor.rowcount == 0:\n            raise HTTPException(status_code=404, detail=\"Task not found\")\n            \n        conn.commit()\n        return JSONResponse(status_code=204)\n\n# Entry point (optional, for running directly)\nif __name__ == \"__main__\":\n    uvicorn.run(app, host=\"0.0.0.0\", port=8000)\n```", "done": true, "done_reason": "stop", "context": [154822, 154824, 154827, 2610, 525, 2661, 264, 25051, 369, 264, 2613, 25336, 5333, 13, 30949, 432, 6896, 438, 5189, 382, 5097, 26601, 279, 2480, 8793, 315, 264, 3175, 1034, 6941, 1887, 7197, 11, 4766, 825, 53913, 12663, 2038, 2504, 13, 2308, 16134, 1573, 476, 1283, 279, 2038, 2504, 13, 3155, 537, 6718, 3941, 5248, 3542, 382, 56101, 1447, 2, 5430, 39958, 5333, 1959, 10951, 271, 11061, 264, 25336, 5333, 369, 14838, 9076, 11, 1667, 3070, 32030, 7082, 334, 488, 3070, 81105, 334, 382, 565, 26582, 16963, 320, 21967, 11, 773, 2550, 374, 1273, 480, 3941, 4119, 692, 12, 46851, 1082, 781, 1034, 25, 1565, 3817, 7197, 7808, 518, 279, 2390, 3704, 624, 12, 576, 17267, 7082, 906, 2867, 1969, 387, 1159, 480, 438, 1565, 3817, 1601, 18606, 12, 14683, 25, 28235, 11, 304, 264, 1034, 6941, 1565, 24684, 7076, 63, 304, 279, 3238, 6220, 13, 4230, 279, 5952, 45058, 9459, 389, 20524, 421, 432, 3171, 944, 3000, 320, 2152, 11371, 11900, 3019, 4292, 12, 57228, 19506, 25, 1565, 9346, 2068, 7808, 1565, 12052, 50030, 7808, 1565, 3288, 67, 8158, 7808, 323, 2987, 279, 1460, 2740, 1565, 36848, 18, 63, 476, 1565, 3544, 34731, 28487, 2308, 1008, 12620, 92864, 320, 68, 1302, 13, 902, 28076, 14941, 5846, 4292, 12, 2308, 16636, 11, 902, 7299, 8693, 10515, 1959, 3175, 6094, 3383, 1140, 382, 565, 2885, 1614, 25, 5430, 271, 91, 8600, 760, 3990, 760, 18040, 9245, 91, 4421, 91, 4421, 91, 4421, 7360, 91, 877, 760, 526, 760, 3