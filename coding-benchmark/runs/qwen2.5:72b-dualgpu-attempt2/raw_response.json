{"model": "qwen2.5:72b", "created_at": "2026-09-17T17:12:16.947409519Z", "response": "```python\nfrom fastapi import FastAPI, HTTPException, Query, Path, Body, Depends\nfrom pydantic import BaseModel, Field, validator\nfrom typing import Optional, List\nimport sqlite3\nfrom datetime import datetime\nfrom contextlib import closing\n\napp = FastAPI()\n\nDATABASE = 'tasks.db'\n\nclass TaskCreate(BaseModel):\n    title: str = Field(..., min_length=1, max_length=200)\n    description: Optional[str] = None\n    priority: Optional[str] = Field(default='medium', regex='^(low|medium|high)$')\n\n    @validator('title')\n    def title_not_empty(cls, v):\n        if not v.strip():\n            raise ValueError('Title cannot be empty')\n        return v.strip()\n\nclass TaskUpdate(BaseModel):\n    title: Optional[str] = Field(None, min_length=1, max_length=200)\n    description: Optional[str] = None\n    completed: Optional[bool] = None\n    priority: Optional[str] = Field(None, regex='^(low|medium|high)$')\n\n    @validator('title')\n    def title_not_empty(cls, v):\n        if v is not None and not v.strip():\n            raise ValueError('Title cannot be empty')\n        return v.strip() if v is not None else v\n\nclass Task(TaskCreate):\n    id: int\n    completed: bool = False\n    created_at: str\n\n    class Config:\n        orm_mode = True\n\ndef get_db():\n    conn = sqlite3.connect(DATABASE)\n    conn.row_factory = sqlite3.Row\n    yield conn\n    conn.close()\n\n@app.on_event(\"startup\")\ndef startup():\n    with closing(sqlite3.connect(DATABASE)) as conn:\n        conn.execute('''\n            CREATE TABLE IF NOT EXISTS tasks (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                title TEXT NOT NULL,\n                description TEXT,\n                completed BOOLEAN DEFAULT FALSE,\n                priority TEXT DEFAULT 'medium',\n                created_at TEXT NOT NULL\n            )\n        ''')\n        conn.commit()\n\n@app.post(\"/tasks\", response_model=Task, status_code=201)\ndef create_task(task: TaskCreate, db: sqlite3.Connection = Depends(get_db)):\n    now = datetime.utcnow().isoformat()\n    cursor = db.execute('''\n        INSERT INTO tasks (title, description, priority, created_at)\n        VALUES (?, ?, ?, ?)\n    ''', (task.title, task.description, task.priority, now))\n    db.commit()\n    task_id = cursor.lastrowid\n    return Task(id=task_id, completed=False, created_at=now, **task.dict())\n\n@app.get(\"/tasks\", response_model=List[Task])\ndef list_tasks(\n    completed: Optional[bool] = None,\n    priority: Optional[str] = Query(None, regex='^(low|medium|high)$'),\n    page: int = Query(1, ge=1),\n    page_size: int = Query(10, ge=1, le=100),\n    db: sqlite3.Connection = Depends(get_db)\n):\n    query = 'SELECT * FROM tasks WHERE 1=1'\n    params = []\n\n    if completed is not None:\n        query += ' AND completed = ?'\n        params.append(completed)\n\n    if priority is not None:\n        query += ' AND priority = ?'\n        params.append(priority)\n\n    query += ' ORDER BY id ASC LIMIT ? OFFSET ?'\n    params.extend([page_size, (page - 1) * page_size])\n\n    cursor = db.execute(query, params)\n    tasks = [Task(**row) for row in cursor.fetchall()]\n\n    total_query = 'SELECT COUNT(*) AS total FROM tasks WHERE 1=1'\n    total_params = []\n\n    if completed is not None:\n        total_query += ' AND completed = ?'\n        total_params.append(completed)\n\n    if priority is not None:\n        total_query += ' AND priority = ?'\n        total_params.append(priority)\n\n    total_cursor = db.execute(total_query, total_params)\n    total = total_cursor.fetchone()['total']\n\n    return {\n        \"items\": tasks,\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size\n    }\n\n@app.get(\"/tasks/{id}\", response_model=Task)\ndef get_task(id: int = Path(..., ge=1), db: sqlite3.Connection = Depends(get_db)):\n    cursor = db.execute('SELECT * FROM tasks WHERE id = ?', (id,))\n    row = cursor.fetchone()\n    if not row:\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n    return Task(**row)\n\n@app.put(\"/tasks/{id}\", response_model=Task)\ndef update_task(\n    id: int = Path(..., ge=1),\n    task_update: TaskUpdate = Body(...),\n    db: sqlite3.Connection = Depends(get_db)\n):\n    update_fields = task_update.dict(exclude_unset=True)\n    if not update_fields:\n        raise HTTPException(status_code=422, detail=\"No fields to update\")\n\n    set_clause = ', '.join(f\"{field} = ?\" for field in update_fields)\n    params = list(update_fields.values())\n    params.append(id)\n\n    cursor = db.execute(f'UPDATE tasks SET {set_clause} WHERE id = ?', params)\n    if cursor.rowcount == 0:\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n\n    db.commit()\n    return get_task(id, db)\n\n@app.delete(\"/tasks/{id}\", status_code=204)\ndef delete_task(id: int = Path(..., ge=1), db: sqlite3.Connection = Depends(get_db)):\n    cursor = db.execute('DELETE FROM tasks WHERE id = ?', (id,))\n    if cursor.rowcount == 0:\n        raise HTTPException(status_code=404, detail=\"Task not found\")\n    db.commit()\n```", "done": true, "done_reason": "stop", "context": [151644, 8948, 198, 2610, 525, 1207, 16948, 11, 3465, 553, 54364, 14817, 13, 1446, 525, 264, 10950, 17847, 13, 151645, 198, 151644, 872, 198, 2610, 525, 2661, 264, 25128, 369, 264, 2613, 25414, 5333, 13, 31075, 432, 6896, 438, 5189, 382, 5097, 26687, 279, 2480, 8794, 315, 264, 3175, 1034, 6941, 1887, 7197, 11, 4766, 825, 54275, 12669, 2038, 2504, 13, 2308, 16148, 1573, 476, 1283, 279, 2038, 2504, 13, 3155, 537, 6718, 3941, 5248, 3542, 382, 56481, 1447, 2, 5430, 40179, 5333, 1959, 10956, 271, 11066, 264, 25414, 5333, 369, 14849, 9079, 11, 1667, 3070, 32174, 7082, 334, 488, 3070, 81772, 334, 382, 565, 26668, 16982, 320, 22021, 11, 773, 2550, 374, 1273, 480, 3941, 4119, 692, 12, 47141, 1082, 781, 1034, 25, 1565, 3