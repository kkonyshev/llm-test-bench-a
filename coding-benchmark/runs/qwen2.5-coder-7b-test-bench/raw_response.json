{"model": "qwen2.5-coder-7b-test-bench", "created_at": "2026-09-11T19:02:25.838299808Z", "response": "```python\nfrom fastapi import FastAPI, HTTPException, Query, Body\nfrom pydantic import BaseModel, validator\nfrom datetime import datetime\nimport sqlite3\n\napp = FastAPI()\n\nclass TaskIn(BaseModel):\n    title: str\n    description: str = None\n    completed: bool = False\n    priority: str = \"medium\"\n\n    @validator('title')\n    def title_must_be_non_empty(cls, v):\n        v = v.strip()\n        if not v:\n            raise ValueError('Title cannot be empty')\n        if len(v) > 200:\n            raise ValueError('Title must be at most 200 characters')\n        return v\n\n    @validator('priority')\n    def priority_must_be_valid(cls, v):\n        if v not in [\"low\", \"medium\", \"high\"]:\n            raise ValueError('Priority must be one of low, medium, high')\n        return v\n\nclass TaskOut(BaseModel):\n    id: int\n    title: str\n    description: str\n    completed: bool\n    priority: str\n    created_at: datetime\n\n    class Config:\n        orm_mode = True\n\nclass TaskDB:\n    def __init__(self):\n        self.con = sqlite3.connect('tasks.db')\n        self.con.row_factory = sqlite3.Row\n        self.setup_db()\n\n    def setup_db(self):\n        with self.con:\n            self.con.execute('''\n                CREATE TABLE IF NOT EXISTS tasks (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    title TEXT NOT NULL,\n                    description TEXT,\n                    completed BOOLEAN NOT NULL DEFAULT 0,\n                    priority TEXT NOT NULL DEFAULT 'medium',\n                    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP\n                )\n            ''')\n\n    def get_tasks(self, completed=None, priority=None, page=1, page_size=10):\n        query = 'SELECT * FROM tasks'\n        params = []\n        if completed is not None:\n            query += ' WHERE completed = ?'\n            params.append(completed)\n        if priority is not None:\n            if query.endswith('WHERE'):\n                query += ' AND'\n            else:\n                query += ' WHERE'\n            query += ' priority = ?'\n            params.append(priority)\n        if page_size < 1 or page_size > 100:\n            raise HTTPException(status_code=422, detail='Page size must be between 1 and 100')\n        offset = (page - 1) * page_size\n        query += ' LIMIT ? OFFSET ?'\n        params.extend([page_size, offset])\n        tasks = self.con.execute(query, params).fetchall()\n        return [TaskOut(**dict(task)) for task in tasks]\n\n    def get_task(self, task_id):\n        task = self.con.execute('SELECT * FROM tasks WHERE id = ?', (task_id,)).fetchone()\n        if task is None:\n            raise HTTPException(status_code=404, detail='Task not found')\n        return TaskOut(**dict(task))\n\n    def create_task(self, task_in: TaskIn):\n        task = task_in.dict()\n        task['created_at'] = datetime.utcnow().isoformat()\n        with self.con:\n            self.con.execute('INSERT INTO tasks (title, description, completed, priority, created_at) VALUES (?, ?, ?, ?, ?)',\n                             (task['title'], task['description'], task['completed'], task['priority'], task['created_at']))\n            task['id'] = self.con.lastrowid\n        return TaskOut(**task)\n\n    def update_task(self, task_id, task_in: TaskIn):\n        task = task_in.dict(exclude_unset=True)\n        if task:\n            set_clause = ', '.join([f\"{k} = ?\" for k in task.keys()])\n            params = list(task.values()) + [task_id]\n            with self.con:\n                self.con.execute(f'UPDATE tasks SET {set_clause} WHERE id = ?', params)\n        else:\n            raise HTTPException(status_code=400, detail='No updates provided')\n        task = self.get_task(task_id)\n        return task\n\n    def delete_task(self, task_id):\n        with self.con:\n            self.con.execute('DELETE FROM tasks WHERE id = ?', (task_id,))\n\ntask_db = TaskDB()\n\n@app.post(\"/tasks\", response_model=TaskOut, status_code=201)\ndef create_task(task_in: TaskIn):\n    return task_db.create_task(task_in)\n\n@app.get(\"/tasks\", response_model=dict)\ndef list_tasks(completed: bool = None, priority: str = None, page: int = Query(1, ge=1), page_size: int = Query(10, ge=1, le=100)):\n    tasks = task_db.get_tasks(completed, priority, page, page_size)\n    total = len(tasks_db.get_tasks())\n    return {\n        \"items\": tasks,\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size\n    }\n\n@app.get(\"/tasks/{id}\", response_model=TaskOut)\ndef get_task(id: int):\n    return task_db.get_task(id)\n\n@app.put(\"/tasks/{id}\", response_model=TaskOut)\ndef update_task(id: int, task_in: TaskIn):\n    return task_db.update_task(id, task_in)\n\n@app.delete(\"/tasks/{id}\", status_code=204)\ndef delete_task(id: int):\n    task_db.delete_task(id)\n```", "done": true, "done_reason": "stop", "context": [151644, 8948, 198, 2610, 525, 1207, 16948, 11, 3465, 553, 54364, 14817, 13, 1446, 525, 264, 10950, 17847, 13, 151645, 198, 151644, 872, 198, 2610, 525, 2661, 264, 25128, 369, 264, 2613, 25414, 5333, 13, 31075, 432, 6896, 438, 5189, 382, 5097, 26687, 279, 2480, 8794, 315, 264, 3175, 1034, 6941, 1887, 7197, 11, 4766, 825, 54275, 12669, 2038, 2504, 13, 2308, 16148, 1573, 476, 1283, 279, 2038, 2504, 13, 3155, 537, 6718, 3941, 5248, 3542, 382, 56481, 1447, 2, 5430, 40179, 5333, 1959, 10956, 271, 11066, 264, 25414, 5333, 369, 14849, 9079, 11, 1667, 3070, 32174, 7082, 334, 488, 3070, 81772, 334, 382, 565, 26668, 16982, 320, 22021, 11, 773, 2550, 374, 1273, 480, 3941, 4119, 692, 12, 47141, 1082, 781, 1034, 25, 1565, 3817, 7197, 7808, 518, 279, 2390, 3704, 624, 12, 576, 17288, 7082, 906, 2867, 1969, 387, 1159, 480, 438, 1565, 3817, 1601, 18639, 12, 14693, 25, 28334, 11, 304, 264, 1034, 6941, 1565, 24760, 7076, 63, 304, 279, 323